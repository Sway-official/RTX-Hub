<html lang="en">
<head>
<meta charset="UTF-8">
<title>RTXHub</title>
<style>
body { background:#111; color:white; font-family:sans-serif; display:flex; flex-direction:column; align-items:center; justify-content:center; height:100vh; gap:15px; }
button { padding:10px 20px; border:none; border-radius:8px; cursor:pointer; background:#1e90ff; color:white; font-weight:bold; }
input { padding:10px; border-radius:8px; border:none; text-align:center; font-weight:bold; }
</style>
</head>
<body>

<h1>RTXHub Key System</h1>

<!-- Captcha -->
<div id="captcha"></div>
<input type="text" id="captchaInput" placeholder="Enter captcha" maxlength="6">
<button id="verifyBtn">Verify & Continue</button>
<p id="error" style="color:red"></p>

<!-- Key section -->
<div id="keySection" style="display:none;">
  <input id="keyBox" readonly>
  <button id="copyBtn">Copy Key</button>
  <p>Time remaining: <span id="countdown"></span></p>
</div>

<script>
const captchaChars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
let captchaCode = '';
let key = '';
let expiry = 0;

function generateCaptcha() {
  captchaCode = '';
  for(let i=0;i<6;i++) captchaCode += captchaChars.charAt(Math.floor(Math.random()*captchaChars.length));
  document.getElementById('captcha').textContent = captchaCode;
  document.getElementById('captchaInput').value = '';
  document.getElementById('error').textContent = '';
}
generateCaptcha();

document.getElementById('verifyBtn').onclick = function(){
  if(document.getElementById('captchaInput').value.toUpperCase() === captchaCode){
    document.getElementById('captcha').style.display='none';
    document.getElementById('captchaInput').style.display='none';
    this.style.display='none';
    generateKey();
  } else {
    document.getElementById('error').textContent = "Incorrect captcha!";
    generateCaptcha();
  }
};

function generateKey(){
  key = 'RTX-';
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
  for(let i=0;i<16;i++){
    if(i>0 && i%4===0) key += '-';
    key += chars.charAt(Math.floor(Math.random()*chars.length));
  }
  expiry = Date.now() + 12*60*60*1000;
  document.getElementById('keySection').style.display='block';
  document.getElementById('keyBox').value = key;
  startCountdown();
}

document.getElementById('copyBtn').onclick = function(){
  navigator.clipboard.writeText(key);
  alert("Key copied!");
};

function startCountdown(){
  const interval = setInterval(()=>{
    let diff = expiry - Date.now();
    if(diff <=0){
      document.getElementById('countdown').textContent = "EXPIRED";
      clearInterval(interval);
      return;
    }
    const h = Math.floor(diff/3600000);
    const m = Math.floor((diff%3600000)/60000);
    const s = Math.floor((diff%60000)/1000);
    document.getElementById('countdown').textContent = `${h}h ${m}m ${s}s`;
  },1000);
}
</script>

</body>
</html>
