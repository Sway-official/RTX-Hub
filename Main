// This validates keys from your Roblox script
export default async function handler(req, res) {
  // Enable CORS for Roblox requests
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET');
  
  const { key } = req.query;
  
  if (!key) {
    return res.status(400).json({ 
      valid: false, 
      message: 'No key provided' 
    });
  }

  // Check localStorage equivalent (you'll need to implement storage)
  // For now, we'll validate format and check if it's in valid time range
  
  if (!key.startsWith('RTX-') || key.length !== 24) {
    return res.status(400).json({ 
      valid: false, 
      message: 'Invalid key format' 
    });
  }

  // In production, check against database
  // For demo, accept all properly formatted keys
  return res.status(200).json({
    valid: true,
    message: 'Key is valid',
    key: key
  });
}
