import React, { useState, useEffect } from 'react';
import { Clock, Key, CheckCircle, Lock, Zap, Copy, Check, RefreshCw, Shield } from 'lucide-react';

const RTXHub = () => {
  const [page, setPage] = useState('landing');
  const [taskCompleted, setTaskCompleted] = useState(false);
  const [generatedKey, setGeneratedKey] = useState(null);
  const [timeRemaining, setTimeRemaining] = useState(null);
  const [copied, setCopied] = useState(false);
  
  // Captcha state
  const [captchaCode, setCaptchaCode] = useState('');
  const [captchaInput, setCaptchaInput] = useState('');
  const [captchaError, setCaptchaError] = useState('');
  const [attempts, setAttempts] = useState(0);

  // Generate random captcha
  const generateCaptcha = () => {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let code = '';
    for (let i = 0; i < 6; i++) {
      code += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    setCaptchaCode(code);
    setCaptchaInput('');
    setCaptchaError('');
  };

  useEffect(() => {
    generateCaptcha();
  }, []);

  // Generate random key
  const generateKey = () => {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    let key = 'RTX-';
    for (let i = 0; i < 16; i++) {
      if (i > 0 && i % 4 === 0) key += '-';
      key += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return key;
  };

  // Verify captcha
  const handleCaptchaSubmit = () => {
    setAttempts(attempts + 1);
    
    if (captchaInput.toUpperCase() === captchaCode) {
      setTaskCompleted(true);
      setPage('confirmation');
    } else {
      setCaptchaError('Incorrect captcha. Please try again.');
      generateCaptcha();
      setTimeout(() => setCaptchaError(''), 3000);
    }
  };

  // Handle Enter key press
  const handleKeyPress = (e) => {
    if (e.key === 'Enter') {
      handleCaptchaSubmit();
    }
  };

  // Generate 12-hour key with storage
  const handleGenerateKey = async () => {
    const key = generateKey();
    const expiryTime = Date.now() + (12 * 60 * 60 * 1000);
    
    const keyData = {
      key: key,
      expiry: expiryTime,
      created: Date.now(),
      hwid: 'TEMP-' + Math.random().toString(36).substr(2, 9)
    };
    
    // Store key in persistent storage
    try {
      await window.storage.set(`key:${key}`, JSON.stringify(keyData));
      setGeneratedKey(keyData);
      setPage('generate');
    } catch (error) {
      console.error('Storage error:', error);
      setGeneratedKey(keyData);
      setPage('generate');
    }
  };

  // Countdown timer
  useEffect(() => {
    if (generatedKey) {
      const interval = setInterval(() => {
        const now = Date.now();
        const remaining = generatedKey.expiry - now;
        
        if (remaining <= 0) {
          setTimeRemaining('EXPIRED');
          clearInterval(interval);
        } else {
          const hours = Math.floor(remaining / (1000 * 60 * 60));
          const minutes = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((remaining % (1000 * 60)) / 1000);
          setTimeRemaining(`${hours}h ${minutes}m ${seconds}s`);
        }
      }, 1000);
      
      return () => clearInterval(interval);
    }
  }, [generatedKey]);

  // Copy to clipboard
  const copyToClipboard = () => {
    navigator.clipboard.writeText(generatedKey.key);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  // Captcha canvas with distortion
  const CaptchaDisplay = () => {
    return (
      <div className="relative bg-gradient-to-br from-gray-800 to-gray-900 rounded-lg p-6 border-2 border-cyan-500/30 mb-4">
        <div className="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-50"></div>
        
        <div className="relative flex items-center justify-center h-20">
          {captchaCode.split('').map((char, i) => (
            <span
              key={i}
              className="text-4xl font-bold mx-1 select-none"
              style={{
                color: `hsl(${180 + i * 30}, 70%, 60%)`,
                transform: `rotate(${(Math.random() - 0.5) * 20}deg) translateY(${(Math.random() - 0.5) * 10}px)`,
                textShadow: '2px 2px 4px rgba(0,0,0,0.5)',
                fontFamily: 'monospace'
              }}
            >
              {char}
            </span>
          ))}
        </div>
        
        {/* Noise lines */}
        <svg className="absolute inset-0 w-full h-full pointer-events-none" style={{ mixBlendMode: 'overlay' }}>
          <line x1="0" y1="30" x2="100%" y2="35" stroke="rgba(255,255,255,0.1)" strokeWidth="1"/>
          <line x1="0" y1="60" x2="100%" y2="55" stroke="rgba(255,255,255,0.1)" strokeWidth="1"/>
          <line x1="0" y1="90" x2="100%" y2="85" stroke="rgba(255,255,255,0.1)" strokeWidth="1"/>
        </svg>
      </div>
    );
  };

  // Landing Page with Real Captcha
  if (page === 'landing') {
    return (
      <div className="min-h-screen bg-gradient-to-br from-purple-900 via-blue-900 to-black text-white">
        <div className="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
        
        <div className="relative z-10 flex flex-col items-center justify-center min-h-screen p-6">
          <div className="mb-8 animate-pulse">
            <Zap className="w-20 h-20 text-cyan-400" strokeWidth={1.5} />
          </div>
          
          <h1 className="text-6xl font-bold mb-4 bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-transparent">
            RTXHub
          </h1>
          
          <p className="text-xl text-gray-300 mb-12 text-center max-w-md">
            Complete the verification to unlock your 12-hour Roblox hub access key
          </p>

          <div className="bg-white/10 backdrop-blur-lg rounded-2xl p-8 border border-white/20 shadow-2xl max-w-md w-full">
            <div className="flex items-center gap-3 mb-6">
              <Shield className="w-6 h-6 text-cyan-400" />
              <h2 className="text-2xl font-semibold">Security Verification</h2>
            </div>
            
            <p className="text-gray-300 mb-6 text-sm">
              Enter the characters you see below to verify you're human
            </p>

            <CaptchaDisplay />

            <button
              onClick={generateCaptcha}
              className="w-full mb-4 flex items-center justify-center gap-2 bg-white/5 hover:bg-white/10 border border-white/20 rounded-lg py-2 transition-all text-sm"
            >
              <RefreshCw className="w-4 h-4" />
              Generate New Code
            </button>

            {captchaError && (
              <div className="mb-4 p-3 bg-red-500/20 border border-red-500/50 rounded-lg text-red-300 text-sm">
                ❌ {captchaError}
              </div>
            )}

            <div>
              <input
                type="text"
                value={captchaInput}
                onChange={(e) => setCaptchaInput(e.target.value)}
                onKeyPress={handleKeyPress}
                placeholder="Enter captcha code"
                className="w-full bg-black/30 border border-white/20 rounded-lg px-4 py-3 mb-4 text-white placeholder-gray-400 focus:outline-none focus:border-cyan-500 uppercase font-mono text-center text-xl tracking-widest"
                maxLength={6}
                autoComplete="off"
              />

              <button
                onClick={handleCaptchaSubmit}
                className="w-full bg-gradient-to-r from-cyan-500 to-purple-500 hover:from-cyan-600 hover:to-purple-600 text-white font-semibold py-3 rounded-lg transition-all transform hover:scale-105 shadow-lg"
              >
                Verify & Continue
              </button>
            </div>

            <div className="mt-4 text-center text-sm text-gray-400">
              Attempts: {attempts}
            </div>
          </div>

          <div className="mt-8 text-center text-sm text-gray-400">
            Powered by RTXHub • Secure Key System
          </div>
        </div>
      </div>
    );
  }

  // Confirmation Page
  if (page === 'confirmation') {
    return (
      <div className="min-h-screen bg-gradient-to-br from-purple-900 via-blue-900 to-black text-white flex items-center justify-center p-6">
        <div className="bg-white/10 backdrop-blur-lg rounded-2xl p-8 border border-white/20 shadow-2xl max-w-md w-full text-center">
          <div className="mb-6 flex justify-center">
            <div className="bg-green-500/20 rounded-full p-6">
              <CheckCircle className="w-16 h-16 text-green-400" />
            </div>
          </div>
          
          <h2 className="text-3xl font-bold mb-4">Verification Complete!</h2>
          
          <p className="text-gray-300 mb-8">
            You've successfully passed the security check. Generate your 12-hour Roblox hub access key now.
          </p>

          <button
            onClick={handleGenerateKey}
            className="w-full bg-gradient-to-r from-cyan-500 to-purple-500 hover:from-cyan-600 hover:to-purple-600 text-white font-semibold py-4 rounded-lg transition-all transform hover:scale-105 shadow-lg flex items-center justify-center gap-2"
          >
            <Key className="w-5 h-5" />
            Generate Your Key
          </button>
        </div>
      </div>
    );
  }

  // Key Generation Page
  if (page === 'generate') {
    return (
      <div className="min-h-screen bg-gradient-to-br from-purple-900 via-blue-900 to-black text-white flex items-center justify-center p-6">
        <div className="bg-white/10 backdrop-blur-lg rounded-2xl p-8 border border-white/20 shadow-2xl max-w-2xl w-full">
          <div className="flex items-center gap-3 mb-6">
            <Key className="w-8 h-8 text-cyan-400" />
            <h2 className="text-3xl font-bold">Your Access Key</h2>
          </div>

          <div className="bg-black/30 rounded-lg p-6 mb-6 border border-cyan-500/30">
            <div className="flex items-center justify-between mb-3">
              <span className="text-sm text-gray-400">KEY CODE</span>
              <button
                onClick={copyToClipboard}
                className="flex items-center gap-2 text-sm bg-white/10 hover:bg-white/20 px-3 py-1 rounded transition-all"
              >
                {copied ? <Check className="w-4 h-4 text-green-400" /> : <Copy className="w-4 h-4" />}
                {copied ? 'Copied!' : 'Copy'}
              </button>
            </div>
            <div className="font-mono text-2xl text-cyan-400 break-all">
              {generatedKey.key}
            </div>
          </div>

          <div className="bg-yellow-500/10 border border-yellow-500/30 rounded-lg p-4 mb-6">
            <div className="flex items-center gap-2 mb-2">
              <Clock className="w-5 h-5 text-yellow-400" />
              <span className="font-semibold text-yellow-400">Time Remaining</span>
            </div>
            <div className="text-2xl font-mono text-white">
              {timeRemaining || 'Calculating...'}
            </div>
          </div>

          <div className="bg-blue-500/10 border border-blue-500/30 rounded-lg p-4 mb-6">
            <h3 className="font-semibold mb-3 text-blue-400">🎮 Roblox Integration Guide</h3>
            <div className="space-y-2 text-sm text-gray-300">
              <p className="flex items-start gap-2">
                <span className="text-cyan-400 font-bold">1.</span>
                Copy your key using the button above
              </p>
              <p className="flex items-start gap-2">
                <span className="text-cyan-400 font-bold">2.</span>
                Open your Roblox executor (Synapse, KRNL, etc.)
              </p>
              <p className="flex items-start gap-2">
                <span className="text-cyan-400 font-bold">3.</span>
                Load your RTXHub script
              </p>
              <p className="flex items-start gap-2">
                <span className="text-cyan-400 font-bold">4.</span>
                Paste the key when prompted
              </p>
              <p className="flex items-start gap-2">
                <span className="text-cyan-400 font-bold">5.</span>
                Key expires in 12 hours - generate a new one after expiry
              </p>
            </div>
          </div>

          <div className="bg-purple-500/10 border border-purple-500/30 rounded-lg p-4 mb-6">
            <h3 className="font-semibold mb-2 text-purple-400">📋 API Validation Endpoint</h3>
            <code className="text-xs text-gray-300 break-all block bg-black/30 p-3 rounded">
              Verify at: https://your-domain.vercel.app/api/verify?key={generatedKey.key}
            </code>
          </div>

          <div className="mt-6 pt-6 border-t border-white/10 text-center text-sm text-gray-400">
            Generated: {new Date(generatedKey.created).toLocaleString()}<br/>
            Expires: {new Date(generatedKey.expiry).toLocaleString()}
          </div>
        </div>
      </div>
    );
  }
};

export default RTXHub;
